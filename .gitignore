# ---- secrets ----
.env
.env.*
!.env.example
*.pem
*.key
!**/public/**/*.key

# ---- python ----
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
dist/
build/
*.db
*.sqlite3
# SQLite in WAL mode leaves -shm/-wal/-journal siblings that `*.db` does not
# match. They are transient and must never be committed.
*.db-shm
*.db-wal
*.db-journal
*.sqlite3-*

# ---- node ----
node_modules/
.next/
out/
.turbo/
coverage/
*.tsbuildinfo
.vercel/
playwright-report/
test-results/
blob-report/
.playwright/

# ---- os / editor ----
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json

# ---- local artefacts ----
/tmp/
*.log

# Local databases (developer and e2e). The -* siblings are covered above too,
# but keep these explicit so the intent is obvious.
/overtake.db
/overtake.db-*
/e2e_test.db
/e2e_test.db-*
