# =============================================================================
# Overtake — environment configuration
#
# Copy to `.env` for local development. NEVER commit a file with real values.
# Production secrets live in the platform's secret store (Fly / Vercel), not
# in the repository.
# =============================================================================

# ---------------------------------------------------------------- core -----
ENVIRONMENT=local                     # local | test | preview | production
DEBUG=false
SEASON=2026/27
WEB_BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:3000
# Explicit allowlist in production; "*" is refused at boot there.
TRUSTED_HOSTS=*

# ------------------------------------------------------------ security -----
# REQUIRED in production. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
SESSION_TTL_DAYS=30
MAGIC_LINK_TTL_MINUTES=15
# Set the SAME value on the API and the web app (32+ characters, generated like
# SECRET_KEY). The web server sends it with each visitor's address so the API
# rate-limits signed-out visitors one by one instead of as one shared server.
INTERNAL_PROXY_SECRET=
# Comma-separated emails exempt from rate limits and plan allowances, for
# testing against production — six rewrites is one afternoon. It grants no paid
# feature and does NOT lift LLM_DAILY_SPEND_CAP_USD below, which is what
# protects the bill. Only accounts you own: every press spends real money.
UNLIMITED_ACCOUNTS=

# ------------------------------------------------------------ database -----
# Local development defaults to SQLite; production MUST be PostgreSQL.
#   postgresql+asyncpg://user:password@host:5432/overtake
# A relative sqlite path is resolved against the repository root, so the same
# value works from api/, from the repo root, and from the worker.
DATABASE_URL=sqlite+aiosqlite:///./overtake.db
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_ECHO=false

# --------------------------------------------------------- FPL ingest ------
FPL_BASE_URL=https://fantasy.premierleague.com/api
# Goes in the User-Agent. Use a real address you monitor — this API is a gift.
FPL_CONTACT_EMAIL=hello@overtakefpl.com
FPL_RATE_LIMIT_PER_SECOND=2.0
FPL_MAX_LEAGUE_SIZE=200

# --------------------------------------------------------- simulation ------
SIM_COUNT=20000
SIM_SEED=8814

# ---------------------------------------------------------------- worker ----
# Longest wait between looks when no job is due. Every look is a query, and a
# query wakes a scale-to-zero database for five minutes — polling every few
# seconds means paying for compute around the clock. Raising this lowers the
# bill and lengthens how long a background refresh can lag; near a deadline the
# schedules run every few minutes regardless.
WORKER_IDLE_MAX_SECONDS=900

# ---------------------------------------------------------------- AI -------
# The model is a config value on purpose: names and prices change constantly,
# and the unit economics depend on being able to change tier without a deploy.
# The AI spec (06-ai-spec.md §Model selection) fixes a TIER, not a name:
# "small-to-mid reasoning model (~$0.30-2.00 / 1M in)". The business model
# budgets EUR 0.25-0.60 per paid user. A premium model would blow both. The
# brief is a small, schema-validated JSON payload, so a small model is right.
LLM_PRIMARY_PROVIDER=anthropic
# Only Anthropic is implemented; the real second tier is the deterministic
# template. Set this to a second provider only once one exists in code.
LLM_FALLBACK_PROVIDER=none
ANTHROPIC_API_KEY=
# Haiku 4.5 is the cheap end of that tier. It failed grounding badly at first,
# but so would any model: the prompt's context block was never filled in, and
# the checks marked it wrong for possessives and for the p10 label the prompt
# told it to cite. Those are fixed, so it gets another run. If briefs start
# coming back as the template again, switch these three to Sonnet 5:
#   ANTHROPIC_MODEL=claude-sonnet-5, LLM_SUPPORTS_EFFORT=true, prices 2.00/10.00
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
# Whether the model above accepts `output_config.effort`. Haiku 4.5 answers 400
# and every brief then degrades to the template; Sonnet 5 accepts it. Change it
# with the model, never on its own.
LLM_SUPPORTS_EFFORT=false
# Used for cost accounting and the hard cap. MUST match the model above, or the
# spend cap protects the wrong number: https://docs.claude.com/en/docs/about-claude/pricing
LLM_PRICE_IN_PER_MTOK=1.00
LLM_PRICE_OUT_PER_MTOK=5.00
# A hard, in-code daily cap. When it is hit, briefs fall back to the
# deterministic template rather than spending more. This is the single control
# that stops a runaway bill sinking the business.
LLM_DAILY_SPEND_CAP_USD=15.0

# ------------------------------------------------------------- billing -----
BILLING_ENABLED=true
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_SEASON=
SEASON_ENDS_AT=2027-05-31T23:59:59Z

# --------------------------------------------------------------- email -----
EMAIL_ENABLED=true
RESEND_API_KEY=
EMAIL_FROM=Overtake <no-reply@overtakefpl.com>

# ------------------------------------------------------- observability -----
SENTRY_DSN=
LOG_LEVEL=INFO
LOG_JSON=true

# ----------------------------------------------------------------- web -----
# Read by the Next.js app. API_INTERNAL_URL is the address the web server uses
# to reach the API; it is never exposed to the browser.
API_INTERNAL_URL=http://127.0.0.1:8000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
