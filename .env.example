# =============================================================================
# Overtake — environment configuration
#
# Copy to `.env` for local development. NEVER commit a file with real values.
# Production secrets live in the platform's secret store (Fly / Vercel), not
# in the repository.
# =============================================================================

# ---------------------------------------------------------------- core -----
ENVIRONMENT=local                     # local | test | preview | production
DEBUG=false
SEASON=2026/27
WEB_BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:3000
# Explicit allowlist in production; "*" is refused at boot there.
TRUSTED_HOSTS=*

# ------------------------------------------------------------ security -----
# REQUIRED in production. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
SESSION_TTL_DAYS=30
MAGIC_LINK_TTL_MINUTES=15

# ------------------------------------------------------------ database -----
# Local development defaults to SQLite; production MUST be PostgreSQL.
#   postgresql+asyncpg://user:password@host:5432/overtake
# A relative sqlite path is resolved against the repository root, so the same
# value works from api/, from the repo root, and from the worker.
DATABASE_URL=sqlite+aiosqlite:///./overtake.db
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_ECHO=false

# --------------------------------------------------------- FPL ingest ------
FPL_BASE_URL=https://fantasy.premierleague.com/api
# Goes in the User-Agent. Use a real address you monitor — this API is a gift.
FPL_CONTACT_EMAIL=hello@overtake.app
FPL_RATE_LIMIT_PER_SECOND=2.0
FPL_MAX_LEAGUE_SIZE=200

# --------------------------------------------------------- simulation ------
SIM_COUNT=20000
SIM_SEED=8814

# ---------------------------------------------------------------- AI -------
# The model is a config value on purpose: names and prices change constantly,
# and the unit economics depend on being able to change tier without a deploy.
# The AI spec (06-ai-spec.md §Model selection) fixes a TIER, not a name:
# "small-to-mid reasoning model (~$0.30-2.00 / 1M in)". The business model
# budgets EUR 0.25-0.60 per paid user. A premium model would blow both. The
# brief is a small, schema-validated JSON payload, so a small model is right.
LLM_PRIMARY_PROVIDER=anthropic
# Only Anthropic is implemented; the real second tier is the deterministic
# template. Set this to a second provider only once one exists in code.
LLM_FALLBACK_PROVIDER=none
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
# Used for cost accounting and the hard cap. MUST match the model above, or the
# spend cap protects the wrong number: https://docs.claude.com/en/docs/about-claude/pricing
LLM_PRICE_IN_PER_MTOK=1.00
LLM_PRICE_OUT_PER_MTOK=5.00
# A hard, in-code daily cap. When it is hit, briefs fall back to the
# deterministic template rather than spending more. This is the single control
# that stops a runaway bill sinking the business.
LLM_DAILY_SPEND_CAP_USD=15.0

# ------------------------------------------------------------- billing -----
BILLING_ENABLED=true
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_SEASON=
SEASON_ENDS_AT=2027-05-31T23:59:59Z

# --------------------------------------------------------------- email -----
EMAIL_ENABLED=true
RESEND_API_KEY=
EMAIL_FROM=Overtake <no-reply@overtake.app>

# ------------------------------------------------------- observability -----
SENTRY_DSN=
LOG_LEVEL=INFO
LOG_JSON=true

# ----------------------------------------------------------------- web -----
# Read by the Next.js app. API_INTERNAL_URL is the address the web server uses
# to reach the API; it is never exposed to the browser.
API_INTERNAL_URL=http://127.0.0.1:8000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
